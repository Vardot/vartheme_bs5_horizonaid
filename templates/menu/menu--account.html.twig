{#
/**
 * Template for the account menu.
 */
#}
{# Menu items arrive keyed by plugin id; nav-menu wants a list. #}
{% set menu_items = [] %}
{% for item in items %}
  {% set menu_items = menu_items|merge([item]) %}
{% endfor %}
{% include 'vartheme_bs5_horizonaid:nav-menu' with {
  items: menu_items,
  nav_menu_utility_classes: [
    'navbar-nav',
  ],
} %}
