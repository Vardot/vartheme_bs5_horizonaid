{#
/**
 * @file
 * Vartheme BS5 Horizonaid Starter Kit implementation for the Profile Card component.
 *
 * - Uploaded photo fills the card above the footer (cover crop, zooms on hover)
 * - Dark footer with one drag & drop slot: content (drop a Heading + Text)
 * - Optional social links (LinkedIn, X, Facebook, Instagram) that pick up an
 *   accent color on hover
 *
 * Available attributes:
 * - media_attributes: Attributes for the photo wrapper.
 * - footer_attributes: Attributes for the footer wrapper.
 * - content_placeholder_attributes: Attributes for the empty-slot placeholder.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set background_color = background_color|default('bg-dark') %}
{% set background_color_class = (background_color != 'none') ? background_color : '' %}
{% set box_shadow = box_shadow|default('shadow-none') %}
{% set corner_style = corner_style|default('rounded-4') %}
{% set linkedin_url = linkedin_url|default('')|trim %}
{% set twitter_url = twitter_url|default('')|trim %}
{% set facebook_url = facebook_url|default('')|trim %}
{% set instagram_url = instagram_url|default('')|trim %}

{# Variables: boolean props.
 # SDC validates `type: boolean` props and applies their schema defaults,
 # so the values arrive as real booleans — only a presence fallback is
 # needed here, never type coercion.
 #}
{% set card_border = card_border ?? false %}
{% set equal_height = equal_height ?? false %}

{# Logic: photo (uploaded image fills the card above the footer). #}
{% set image = image|default({}) %}
{% set has_image = (image.src is defined) and (image.src|trim is not empty) %}
{% if has_image and image.src starts with 'assets/' and component_metadata.path is defined %}
  {% set image = image|merge({ src: component_metadata.path ~ '/' ~ image.src }) %}
{% endif %}

{# Logic: social links — fixed platform set (matches the icon component's
 # social icons); only platforms with a URL are rendered. #}
{% set socials = [
  { key: 'linkedin', icon: 'linkedin', url: linkedin_url, label: 'LinkedIn' },
  { key: 'twitter', icon: 'twitter-x', url: twitter_url, label: 'X (Twitter)' },
  { key: 'facebook', icon: 'facebook', url: facebook_url, label: 'Facebook' },
  { key: 'instagram', icon: 'instagram', url: instagram_url, label: 'Instagram' },
]|filter(s => s.url is not empty) %}
{% set has_social = socials|length > 0 %}

{# Logic: drag & drop content slot. #}
{% set content_slot %}{% block content %}{% endblock %}{% endset %}
{% set has_content_slot = content_slot|render|trim is not empty %}

{# Logic: merge card classes as arrays. #}
{% set attributes = attributes.addClass([
  'card',
  'card-profile',
  'd-flex',
  'flex-column',
  'overflow-hidden',
  'position-relative',
  corner_style,
  (card_border ? 'border' : 'border-0'),
  box_shadow,
  (equal_height ? 'h-100' : ''),
]|filter(v => v is not empty)) %}

{% if not media_attributes %}
  {% set media_attributes = create_attribute() %}
{% endif %}
{% set media_attributes = media_attributes.addClass([
  'card-profile__media',
  'position-relative',
  'overflow-hidden',
  'flex-grow-1',
]) %}

{% if not footer_attributes %}
  {% set footer_attributes = create_attribute() %}
{% endif %}
{% set footer_attributes = footer_attributes.addClass([
  'card-profile__footer',
  'card-body',
  'p-4',
  'd-flex',
  'flex-column',
  'gap-2',
  background_color_class,
]|filter(v => v is not empty)) %}

{% set content_placeholder_attributes = create_attribute().addClass([
  'text-white-50',
  'small',
  'pe-none',
]) %}

{# Print the HTML. #}
<div{{ attributes }}>

  {# Photo — fills the card above the footer #}
  <div{{ media_attributes }}>
    {% if has_image %}
      {{ include('vartheme_bs5_horizonaid:image', {
        media: image,
        ratio: 'ratio-auto',
        fit: 'object-fit-cover',
        width: 'w-100',
        align: 'mx-auto',
        loading: 'eager',
        cover_fill: true,
        attributes: create_attribute().addClass(['card-profile__photo', 'h-100', 'w-100', 'm-0']),
      }, with_context = false) }}
    {% endif %}
  </div>

  <div{{ footer_attributes }}>
    <div class="card-profile__top d-flex align-items-start justify-content-between gap-3">

      {# Drag & drop content slot (drop a Heading + Text for name/description) #}
      <div class="card-profile__content flex-grow-1">
        {% if has_content_slot %}
          {{ content_slot }}
        {% else %}
          <div{{ content_placeholder_attributes }}>Drop heading & text here</div>
        {% endif %}
      </div>

      {# Optional social links — right-aligned next to the content #}
      {% if has_social %}
        <div class="card-profile__social d-flex align-items-center gap-2 flex-shrink-0">
          {% for social in socials %}
            {# Uses the lower-level bootstrap-icon atom (not atoms/icon) so no
             # forced `text-*` utility class is added — Bootstrap's color
             # utilities are !important and would block the hover transition
             # below, so color is fully owned by card-profile.scss. #}
            {% set social_icon_markup %}
              {{ include('vartheme_bs5_horizonaid:bootstrap-icon', {
                icon: social.icon,
                icon_size: 'fs-5',
              }, with_context = false) }}
            {% endset %}
            {{ include('vartheme_bs5_horizonaid:link', {
              url: social.url,
              attributes: create_attribute()
                .addClass(['card-profile__social-link'])
                .setAttribute('aria-label', social.label)
                .setAttribute('target', '_blank')
                .setAttribute('rel', 'noopener noreferrer'),
              content: social_icon_markup,
            }, with_context = false) }}
          {% endfor %}
        </div>
      {% endif %}

    </div>
  </div>
</div>
