{% stories MediaBanner with {
  title: 'Hero/Media Banner',
  parameters: {
    componentSubtitle: 'Media banner with an uploaded image and a floating content box',
    docs: {
      description: {
        component: 'Media banner with an uploaded image and a floating content box slot for a heading, text, buttons, or any other component. Bootstrap 5 utilities only.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    image_radius: {
      name: 'Image border radius',
      defaultValue: 'rounded-hero',
      control: 'select',
      options: {
        Square: 'none',
        "'Small (0.5rem)'": 'rounded-2',
        "'Medium (0.75rem)'": 'rounded-3',
        "'Large (1rem)'": 'rounded-4',
        "'Default (1.25rem)'": 'rounded-hero',
        "'Extra large (1.5rem)'": 'rounded-5',
        Pill: 'rounded-pill',
      },
    },
    content_bg: {
      name: 'Content box background',
      defaultValue: 'bg-light',
      control: 'select',
      options: {
        Transparent: 'bg-transparent',
        White: 'bg-white',
        Light: 'bg-light',
        Dark: 'bg-dark',
        Black: 'bg-black',
        Primary: 'bg-primary',
        Secondary: 'bg-secondary',
      },
    },
    content_color: {
      name: 'Content box text color',
      defaultValue: 'auto',
      control: 'select',
      options: {
        "'Auto (based on background)'": 'auto',
        "'Dark text'": 'text-dark',
        "'White text'": 'text-white',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    media: {
      src: '/themes/contrib/vartheme_bs5_horizonaid/components/foundation/images/assets/banner-2.jpg',
      alt: 'Children celebrating at a refugee camp event',
      width: 1920,
      height: 1075,
    },
    image_radius: 'rounded-hero',
    content_bg: 'bg-light',
    content_color: 'auto',
  },
} %}
{% embed 'vartheme_bs5_horizonaid:media-banner' %}
  {% block content %}
    {{ include('vartheme_bs5_horizonaid:heading', {
      heading_text: 'Title',
      level: 2,
      text_color: 'text-dark',
    }, false) }}
    {{ include('vartheme_bs5_horizonaid:text', {
      text: '<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc non sapien lacinia, pellent...</p>',
      text_color: 'text-dark',
    }, false) }}
    {{ include('vartheme_bs5_horizonaid:button', {
      label: 'Button',
      variant: 'btn-primary',
      size: 'btn-md',
      radius: 'rounded-pill',
      alignment: 'left',
    }, false) }}
  {% endblock %}
{% endembed %}
{% endstory %}

