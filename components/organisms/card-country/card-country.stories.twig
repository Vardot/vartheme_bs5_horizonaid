{% stories CardCountry with {
  title: 'Cards/Card Country',
  parameters: {
    componentSubtitle: 'Country / destination card with a photo, drag & drop content, and a hover-reveal footer.',
    docs: {
      description: {
        component: 'A destination teaser card. The footer is clipped to a compact height by default and expands on hover/focus to reveal the full content and an optional "Learn more" link. Supports border, background, shadow, border radius, and equal height.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    image: {
      name: 'Photo',
      description: 'Upload the destination photo. Fills the card above the footer with a cover crop.',
      control: 'object',
    },
    card_border: {
      name: 'Card border',
      description: 'Adds default Bootstrap border.',
      defaultValue: false,
      control: 'boolean',
    },
    background_color: {
      name: 'Footer background',
      description: 'Brand background color applied to the card footer.',
      defaultValue: 'bg-dark',
      control: 'select',
      options: {
        None: 'none',
        "'Body tertiary'": 'bg-body-tertiary',
        Tertiary: 'bg-tertiary',
        Accent: 'bg-accent',
        Primary: 'bg-primary',
        "'Primary subtle'": 'bg-primary-subtle',
        Secondary: 'bg-secondary',
        "'Secondary subtle'": 'bg-secondary-subtle',
        Dark: 'bg-dark',
      },
    },
    box_shadow: {
      name: 'Shadow',
      description: 'Bootstrap shadow utility.',
      defaultValue: 'shadow-sm',
      control: 'select',
      options: {
        None: 'shadow-none',
        Small: 'shadow-sm',
        Medium: 'shadow',
        Large: 'shadow-lg',
      },
    },
    corner_style: {
      name: 'Border radius',
      description: 'Rounded utility for the card.',
      defaultValue: 'rounded-4',
      control: 'select',
      options: {
        "'None (square)'": 'rounded-0',
        Small: 'rounded-1',
        Large: 'rounded-3',
        "'Extra large'": 'rounded-4',
        Pill: 'rounded-pill',
      },
    },
    equal_height: {
      name: 'Equal height',
      description: 'Apply h-100 for grid alignment.',
      defaultValue: false,
      control: 'boolean',
    },
    link_url: {
      name: 'Link URL',
      description: 'Leave empty to hide the link.',
      defaultValue: '',
      control: 'text',
    },
    link_text: {
      name: 'Link text',
      description: 'Visible label for the link.',
      defaultValue: 'Learn more',
      control: 'text',
    },
    link_target: {
      name: 'Link target',
      description: 'Target attribute.',
      defaultValue: 'default',
      control: 'select',
      options: {
        "'Default (same tab)'": 'default',
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    image: { src: '/components/foundation/images/assets/teaser-1.png', alt: 'Peru', width: 261, height: 340 },
    card_border: false,
    background_color: 'bg-dark',
    box_shadow: 'shadow-sm',
    corner_style: 'rounded-4',
    equal_height: false,
    link_url: 'https://example.com/peru',
    link_text: 'Learn more',
    link_target: 'default',
  },
} %}
{% embed 'vartheme_bs5_horizonaid:card-country' with _context %}
  {% block content %}
    <h3 class="h5 mb-0 text-white">Peru</h3>
    <p class="mb-0 text-white-50 mt-2">Discover the ancient wonders of Machu Picchu and the vibrant culture of the Andes.</p>
  {% endblock %}
{% endembed %}
{% endstory %}

