{% stories CountrySlider with {
  title: 'Cards/Country Slider',
  parameters: {
    componentSubtitle: 'Heading + description above a horizontally-scrolling row of Country Card components.',
    docs: {
      description: {
        component: 'A heading, description, and a "View all" link sit above a horizontally-scrolling row of Country Card components with prev/next controls. Add one or more "Country Card" components into the slot — unlimited, drag & drop reorder. Bootstrap has no multi-item-visible slider, so the track uses CSS Scroll Snap.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    heading_text: {
      name: 'Heading text',
      defaultValue: 'Where We Work',
      control: 'text',
    },
    heading_level: {
      name: 'Heading level',
      defaultValue: 2,
      control: 'number',
    },
    description_text: {
      name: 'Description (rich text)',
      control: 'text',
    },
    container_type: {
      name: 'Container width',
      defaultValue: 'container',
      control: 'select',
      options: {
        "'Standard container'": 'container',
        "'Full width container'": 'container-fluid',
        "'No container'": 'none',
      },
    },
    cta_label: {
      name: '"View all" link label',
      defaultValue: 'View All Countries',
      control: 'text',
    },
    cta_url: {
      name: '"View all" link URL',
      description: 'Leave empty to hide the link.',
      defaultValue: '',
      control: 'text',
    },
    cta_target: {
      name: 'Link target',
      defaultValue: 'default',
      control: 'select',
      options: {
        "'Default (same tab)'": 'default',
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    heading_text: 'Where We Work',
    heading_level: 2,
    description_text: '<p>Lorem ipsum dolor sit amet consectetur adipiscing elit. Ex sapien vitae pellentesque sem placerat in id.</p>',
    container_type: 'container',
    cta_label: 'View All Countries',
    cta_url: 'https://example.com/countries',
    cta_target: 'default',
  },
} %}
{% embed 'vartheme_bs5_horizonaid:country-slider' with _context only %}
  {% block cards %}
    {% embed 'vartheme_bs5_horizonaid:card-country' with {
      image: { src: '/components/foundation/images/assets/teaser-1.png', alt: 'Ecuador', width: 261, height: 340 },
    } only %}
      {% block content %}
        <h3 class="h5 mb-0 text-white">Ecuador</h3>
      {% endblock %}
    {% endembed %}
    {% embed 'vartheme_bs5_horizonaid:card-country' with {
      image: { src: '/components/foundation/images/assets/teaser-2.jpg', alt: 'Kenya', width: 261, height: 340 },
    } only %}
      {% block content %}
        <h3 class="h5 mb-0 text-white">Kenya</h3>
      {% endblock %}
    {% endembed %}
    {% embed 'vartheme_bs5_horizonaid:card-country' with {
      image: { src: '/components/foundation/images/assets/teaser-3.jpg', alt: 'Lebanon', width: 261, height: 340 },
    } only %}
      {% block content %}
        <h3 class="h5 mb-0 text-white">Lebanon</h3>
      {% endblock %}
    {% endembed %}
    {% embed 'vartheme_bs5_horizonaid:card-country' with {
      image: { src: '/components/foundation/images/assets/teaser-8.jpg', alt: 'Ukraine', width: 261, height: 340 },
    } only %}
      {% block content %}
        <h3 class="h5 mb-0 text-white">Ukraine</h3>
      {% endblock %}
    {% endembed %}
  {% endblock %}
{% endembed %}
{% endstory %}

