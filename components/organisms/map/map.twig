{#
/**
 * @file
 * Vartheme BS5 Horizonaid Starter Kit implementation for the Map component.
 *
 * Self-contained interactive world map — no external map API or key. The
 * country-boundary GeoJSON (a vendored static asset) is projected straight
 * to SVG `<path>` elements by map.js using d3-geo (vendored, see
 * vartheme_bs5_horizonaid.libraries.yml's `d3-geo-vendor` library). This
 * template only renders the static shell, the custom zoom/reset control
 * buttons, and the `countries` slot (one molecules/map-info-card per
 * highlighted country) that doubles as the click popup — map.js discovers
 * which countries to highlight, and what each popup should say, entirely
 * from the slot's own rendered markup (each card's `data-country-code`
 * attribute), not from component props.
 *
 * The GeoJSON asset's URL is NOT built here from `component_metadata.path`
 * (unlike card-text/card-country's narrow, guarded use of it for Storybook
 * example paths) — it resolves to an empty string when Drupal Canvas
 * renders this component through its own API rendering path, 404ing the
 * fetch and breaking the whole map. map.js instead reads it from
 * drupalSettings, computed server-side in
 * vartheme_bs5_horizonaid_page_attachments_alter() (reliable in every
 * rendering context).
 *
 * Available properties:
 * - map_height: Height of the map canvas. (sm | md | lg) Defaults to `md`.
 * - corner_style: Bootstrap rounded utility for the map area. Defaults to `rounded-4`.
 * - box_shadow: Bootstrap shadow utility. Defaults to `shadow-none`.
 * - background_color: Bootstrap background utility for the map area. (none
 *                      | bg-body-tertiary | bg-tertiary | bg-accent
 *                      | bg-accent-subtle | bg-primary | bg-primary-subtle
 *                      | bg-secondary | bg-secondary-subtle | bg-dark)
 *                      Defaults to `bg-body-tertiary`.
 *
 * Available attributes:
 * - map_attributes: Attributes for the SVG map canvas element.
 * - controls_attributes: Attributes for the zoom/reset controls wrapper.
 *
 * Available slots:
 * - content: Optional drag & drop content shown above the map.
 * - countries: One or more molecules/map-info-card components (unlimited),
 *              each with its own "Country code" prop set.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set map_height = map_height|default('md') %}
{% set corner_style = corner_style|default('rounded-4') %}
{% set box_shadow = box_shadow|default('shadow-none') %}
{% set background_color = background_color|default('bg-body-tertiary') %}
{% set background_color_class = (background_color != 'none') ? background_color : '' %}


{# Logic: drag & drop slots. #}
{% set content_slot %}{% block content %}{% endblock %}{% endset %}
{% set has_content_slot = content_slot|render|trim is not empty %}
{% set countries_slot %}{% block countries %}{% endblock %}{% endset %}
{% set has_countries_slot = countries_slot|render|trim is not empty %}

{# Logic: inline action-button icons (zoom in / zoom out / reset). Fills are
 # not hardcoded here — `.map__control-bg` / `.map__control-icon` pick up
 # --map-control-bg / --map-control-icon in map.scss, which default to the
 # theme's $primary and $accent tokens and swap on hover. #}
{% set icon_zoom_in %}
  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="40" height="40" rx="20" class="map__control-bg"/>
    <path d="M20 14.4C20.3866 14.4 20.7 14.7134 20.7 15.1V19.3H24.9C25.2866 19.3 25.6 19.6134 25.6 20C25.6 20.3866 25.2866 20.7 24.9 20.7H20.7V24.9C20.7 25.2866 20.3866 25.6 20 25.6C19.6134 25.6 19.3 25.2866 19.3 24.9V20.7H15.1C14.7134 20.7 14.4 20.3866 14.4 20C14.4 19.6134 14.7134 19.3 15.1 19.3H19.3V15.1C19.3 14.7134 19.6134 14.4 20 14.4Z" class="map__control-icon"/>
  </svg>
{% endset %}
{% set icon_zoom_out %}
  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="40" height="40" rx="20" class="map__control-bg"/>
    <path d="M14.4 20C14.4 19.6134 14.7134 19.3 15.1 19.3H24.9C25.2866 19.3 25.6 19.6134 25.6 20C25.6 20.3866 25.2866 20.7 24.9 20.7H15.1C14.7134 20.7 14.4 20.3866 14.4 20Z" class="map__control-icon"/>
  </svg>
{% endset %}
{% set icon_reset %}
  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="40" height="40" rx="20" class="map__control-bg"/>
    <path fill-rule="evenodd" clip-rule="evenodd" d="M20 15.8583C17.2386 15.8583 15 18.0969 15 20.8583C15 23.6197 17.2386 25.8583 20 25.8583C22.7614 25.8583 25 23.6197 25 20.8583C25 20.1129 24.8372 19.4068 24.5457 18.7727C24.4304 18.5218 24.5403 18.2249 24.7912 18.1095C25.0421 17.9942 25.339 18.1041 25.4543 18.355C25.8048 19.1175 26 19.9658 26 20.8583C26 24.172 23.3137 26.8583 20 26.8583C16.6863 26.8583 14 24.172 14 20.8583C14 17.5446 16.6863 14.8583 20 14.8583V15.8583Z" class="map__control-icon"/>
    <path d="M20 17.3246V13.3921C20 13.1801 20.2472 13.0643 20.41 13.2L22.7695 15.1663C22.8895 15.2662 22.8895 15.4504 22.7695 15.5504L20.41 17.5166C20.2472 17.6523 20 17.5365 20 17.3246Z" class="map__control-icon"/>
  </svg>
{% endset %}

{# Logic: merge card classes as arrays. #}
{% set attributes = attributes.addClass([
  'map',
  'position-relative',
  'overflow-hidden',
  'map--height-' ~ map_height,
  corner_style,
  box_shadow,
  background_color_class,
]|filter(v => v is not empty)) %}

{% if not map_attributes %}
  {% set map_attributes = create_attribute() %}
{% endif %}
{% set map_attributes = map_attributes.addClass(['map__canvas'])
  .setAttribute('data-map-canvas', true)
  .setAttribute('viewBox', '0 0 960 500')
  .setAttribute('role', 'img')
  .setAttribute('aria-label', 'World map'|t)
%}

{% if not controls_attributes %}
  {% set controls_attributes = create_attribute() %}
{% endif %}
{% set controls_attributes = controls_attributes.addClass(['map__controls', 'd-flex', 'flex-column', 'gap-2']) %}

{# Print the HTML. #}
{% if has_content_slot %}
  <div class="map__content mb-3">
    {{ content_slot }}
  </div>
{% endif %}

<div{{ attributes }}>
  <svg{{ map_attributes }}></svg>

  <div{{ controls_attributes }}>
    <button type="button" class="map__control" data-map-action="zoom-in" aria-label="{{ 'Zoom in'|t }}">{{ icon_zoom_in }}</button>
    <button type="button" class="map__control" data-map-action="zoom-out" aria-label="{{ 'Zoom out'|t }}">{{ icon_zoom_out }}</button>
    <button type="button" class="map__control" data-map-action="reset" aria-label="{{ 'Reset view'|t }}">{{ icon_reset }}</button>
  </div>

  {% if has_countries_slot %}
    <div class="map__popup" data-map-popup>
      {{ countries_slot }}
    </div>
  {% endif %}
</div>
