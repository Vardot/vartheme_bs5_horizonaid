{#
/**
 * @file
 * Vartheme BS5 Horizonaid Starter Kit implementation for the User Profile Details component.
 *
 * A Bootstrap card that shows a user their own account: the picture, the
 * account details as a description list, and quick action buttons.
 *
 * Available properties:
 * - heading: The card heading. Defaults to `Profile details`.
 * - username: The account name.
 * - full_name: The person's full name, when the site has a field for it.
 * - email: The account email address.
 * - timezone: The account time zone.
 * - status: (true|false) Whether the account is active. Defaults to `true`.
 * - created: The formatted date the account was created.
 * - member_for: How long the account has existed.
 * - last_login: The formatted date of the last login.
 * - picture_url: The user picture. Empty shows a person icon instead.
 * - picture_alt: The alternative text of the user picture.
 * - actions: Quick action links, each with title, url and variant.
 *   (primary | outline-primary | outline-dark) Defaults to `[]`.
 *
 * Available attributes:
 * - attributes: HTML attributes for the root element.
 * - body_attributes: HTML attributes for the card body.
 * - layout_attributes: HTML attributes for the picture and details row.
 * - picture_wrapper_attributes: HTML attributes for the picture column.
 * - picture_attributes: HTML attributes for the picture image.
 * - details_attributes: HTML attributes for the details column.
 * - heading_attributes: HTML attributes for the card heading.
 * - list_attributes: HTML attributes for the description list.
 * - term_attributes: HTML attributes for each detail label.
 * - value_attributes: HTML attributes for each detail value.
 * - actions_attributes: HTML attributes for the actions row.
 * - action_attributes: HTML attributes for each action button.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set heading = heading|default('Profile details'|t) %}
{% set actions = actions|default([]) %}
{% set picture_alt = picture_alt|default(username) %}

{# Variables: boolean props. #}
{% set status = status ?? true %}

{# Logic: the rows of the description list, empty values left out. #}
{% set details = [
  { label: 'Username'|t, value: username },
  { label: 'Full name'|t, value: full_name },
  { label: 'Email'|t, value: email },
  { label: 'Time zone'|t, value: timezone },
  { label: 'Account status'|t, value: status ? 'Active'|t : 'Blocked'|t },
  { label: 'Account created'|t, value: created },
  { label: 'Member for'|t, value: member_for },
  { label: 'Last login'|t, value: last_login ?: 'Never'|t },
]|filter(row => row.value is not empty) %}

{# Logic: action variants on the brand buttons. A gold outline label fails
 # text contrast on white, so outline-primary takes the accent outline. #}
{% set variant_map = {
  'primary': 'btn-primary',
  'outline-primary': 'btn-outline-accent',
  'outline-dark': 'btn-outline-dark',
} %}

{# Logic: the picture, or a person icon when the account has none. #}
{% if picture_url %}
  {% set picture_attributes = create_attribute()
    .setAttribute('src', picture_url)
    .setAttribute('alt', picture_alt)
    .setAttribute('width', 96)
    .setAttribute('height', 96)
    .setAttribute('loading', 'lazy')
    .addClass(['user-profile-details__image', 'rounded-circle', 'object-fit-cover']) %}
{% endif %}

{# Logic: the nested element attributes. #}
{% set body_attributes = create_attribute().addClass(['card-body', 'p-4']) %}
{% set layout_attributes = create_attribute().addClass(['d-flex', 'flex-column', 'flex-sm-row', 'gap-4']) %}
{% set picture_wrapper_attributes = create_attribute().addClass(['user-profile-details__picture', 'flex-shrink-0']) %}
{% set details_attributes = create_attribute().addClass(['user-profile-details__details', 'flex-grow-1']) %}
{% set heading_attributes = create_attribute().addClass(['user-profile-details__heading', 'card-title', 'h4', 'mb-3']) %}
{% set list_attributes = create_attribute().addClass(['user-profile-details__list', 'row', 'mb-0']) %}
{% set actions_attributes = create_attribute().addClass(['user-profile-details__actions', 'd-flex', 'flex-wrap', 'gap-2', 'mt-3']) %}

{# Logic: merge classes as arrays. #}
{% set classes = ['user-profile-details', 'card', 'rounded-5', 'mb-4'] %}
{% set attributes = attributes.addClass(classes) %}

{# Print the HTML. #}
<section{{ attributes }}>
  <div{{ body_attributes }}>
    <div{{ layout_attributes }}>
      <div{{ picture_wrapper_attributes }}>
        {% if picture_url %}
          <img{{ picture_attributes }}>
        {% else %}
          {{ include('vartheme_bs5_horizonaid:bootstrap-icon', {
            icon: 'person-circle',
            icon_size: 'fs-1',
            color: 'text-secondary',
            attributes: create_attribute().setAttribute('aria-hidden', 'true'),
          }, with_context = false) }}
        {% endif %}
      </div>
      <div{{ details_attributes }}>
        <h2{{ heading_attributes }}>{{ heading }}</h2>
        <dl{{ list_attributes }}>
          {% for row in details %}
            {% set term_attributes = create_attribute().addClass(['col-sm-4']) %}
            {% set value_attributes = create_attribute().addClass(['col-sm-8', 'text-break']) %}
            <dt{{ term_attributes }}>{{ row.label }}</dt>
            <dd{{ value_attributes }}>{{ row.value }}</dd>
          {% endfor %}
        </dl>
        {% if actions is not empty %}
          <div{{ actions_attributes }}>
            {% for action in actions %}
              {% set action_attributes = create_attribute()
                .setAttribute('href', action.url)
                .addClass(['btn', 'btn-sm', variant_map[action.variant|default('outline-primary')]]) %}
              <a{{ action_attributes }}>{{ action.title }}</a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
