{% stories CardEvents with {
  title: 'Cards/Card Events',
  parameters: {
    componentSubtitle: 'Two-tone event card with taxonomy label, a single drag-and-drop content slot, and a date/time bar.',
    docs: {
      description: {
        component: 'A structured event card: eyebrow taxonomy label, a single drag-and-drop content slot (drop a Heading and a Text component together — headings switch to the accent color on hover), and a bottom date/time bar (date_start/date_end/time are plain text so editors can use any display format). Supports border, shadow, border radius, equal height, and full-card stretched link.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    taxonomy_label: {
      name: 'Taxonomy label',
      description: 'Eyebrow label shown above the content slot.',
      defaultValue: 'Webinar',
      control: 'text',
    },
    date_start: {
      name: 'Start date',
      description: 'Event start date, shown as-is (e.g. "12 Jun").',
      defaultValue: '',
      control: 'text',
    },
    date_end: {
      name: 'End date',
      description: 'Optional event end date, shown as-is (e.g. "30 Jul"). Leave empty for a single-day event.',
      defaultValue: '',
      control: 'text',
    },
    time: {
      name: 'Time',
      description: 'Event time.',
      defaultValue: '11:00 - 2:30 CET',
      control: 'text',
    },
    card_border: {
      name: 'Card border',
      description: 'Adds default Bootstrap border.',
      defaultValue: false,
      control: 'boolean',
    },
    box_shadow: {
      name: 'Shadow',
      description: 'Bootstrap shadow utility.',
      defaultValue: 'shadow-none',
      control: 'select',
      options: {
        None: 'shadow-none',
        Small: 'shadow-sm',
        Medium: 'shadow',
        Large: 'shadow-lg',
      },
    },
    corner_style: {
      name: 'Border radius',
      description: 'Rounded utility for the card.',
      defaultValue: 'rounded-4',
      control: 'select',
      options: {
        "'None (square)'": 'rounded-0',
        Small: 'rounded-1',
        Medium: 'rounded-2',
        Large: 'rounded-3',
        "'Extra Large'": 'rounded-4',
        "'Extra Extra Large'": 'rounded-5',
        Pill: 'rounded-pill',
      },
    },
    equal_height: {
      name: 'Equal height',
      description: 'Apply h-100 for grid alignment.',
      defaultValue: false,
      control: 'boolean',
    },
    stretched_link: {
      name: 'Stretched link',
      description: 'Make entire card clickable.',
      defaultValue: false,
      control: 'boolean',
    },
    link_url: {
      name: 'Link URL',
      description: 'Optional card link.',
      defaultValue: '',
      control: 'text',
    },
    link_target: {
      name: 'Link target',
      description: 'Target attribute.',
      defaultValue: 'default',
      control: 'select',
      options: {
        "'Default (same tab)'": 'default',
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    taxonomy_label: 'Webinar',
    date_start: '12 Jun',
    date_end: '30 Jul',
    time: '11:00 - 2:30 CET',
    card_border: false,
    box_shadow: 'shadow-none',
    corner_style: 'rounded-4',
    equal_height: false,
    stretched_link: false,
    link_url: '',
    link_target: 'default',
  },
} %}
{% embed 'vartheme_bs5_horizonaid:card-events' with _context %}
  {% block content %}
    {% include 'vartheme_bs5_horizonaid:heading' with {
      heading_text: 'Event Title',
      level: 3,
    } only %}
    {% include 'vartheme_bs5_horizonaid:text' with {
      text: '<p>Lorem ipsum dolor sit amet consectetur adipiscing elit. Ex sapien vitae pellentesque sem placerat in id. Pretium tellus duis convallis tempus</p>',
      text_size: 'none',
      text_color: 'text-body',
    } only %}
  {% endblock %}
{% endembed %}
{% endstory %}

