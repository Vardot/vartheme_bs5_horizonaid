{% stories AccordionContainer with {
  title: 'Layout/Accordion/Accordion container',
  parameters: {
    componentSubtitle: 'Accordion wrapper',
    docs: {
      description: {
        component: 'A wrapper that groups multiple accordion items in a flex column with a fixed gap. Controls whether multiple nested items can stay open at the same time.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    id: {
      name: 'Accordion ID',
      control: 'text',
      defaultValue: '',
    },
    always_open: {
      name: 'Keep multiple items open',
      control: 'boolean',
      defaultValue: false,
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    id: 'default-accordion',
    always_open: false,
  },
} %}
{% set accordion_content %}
    {% set accordion_content %}
        <p class="mb-0">The Accordion container groups multiple accordion items. Only one item can be open at a time in default mode.</p>
      {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-block', {
      title: 'What is this component?',
      heading_level: 3,
      open_by_default: true,
      parent_id: id,
      accordion_content: accordion_content,
    }, with_context: false) }}

    {% set accordion_content %}
        <p class="mb-0">Use it for FAQs, grouped detail sections, product specs, and any content that benefits from collapsible organization.</p>
      {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-block', {
      title: 'When should I use it?',
      heading_level: 3,
      open_by_default: false,
      parent_id: id,
      accordion_content: accordion_content,
    }, with_context: false) }}

    {% set accordion_content %}
        <p class="mb-0">Wrap one or more Accordion block components inside this container. The container manages shared IDs and grouping automatically.</p>
      {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-block', {
      title: 'How does it work?',
      heading_level: 3,
      open_by_default: false,
      parent_id: id,
      accordion_content: accordion_content,
    }, with_context: false) }}
  {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-container', {
  id: id,
  always_open: always_open,
  accordion_content: accordion_content,
}, with_context: false) }}
{% endstory %}

{% story AlwaysOpen with {
  name: 'Always open (multiple expanded)',
  args: {
    id: 'always-open-demo',
    always_open: true,
  },
} %}
{% set accordion_content %}
    {% set accordion_content %}
        <p class="mb-0">With <code>always_open: true</code>, this item stays expanded even when another item is opened.</p>
      {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-block', {
      title: 'First topic',
      heading_level: 3,
      open_by_default: true,
      parent_id: id,
      accordion_content: accordion_content,
    }, with_context: false) }}

    {% set accordion_content %}
        <p class="mb-0">Multiple items can be open at the same time. This is useful for comparison content or reference sections.</p>
      {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-block', {
      title: 'Second topic',
      heading_level: 3,
      open_by_default: true,
      parent_id: id,
      accordion_content: accordion_content,
    }, with_context: false) }}

    {% set accordion_content %}
        <p class="mb-0">This item starts collapsed but can be opened without closing the others.</p>
      {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-block', {
      title: 'Third topic',
      heading_level: 3,
      open_by_default: false,
      parent_id: id,
      accordion_content: accordion_content,
    }, with_context: false) }}
  {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-container', {
  id: id,
  always_open: always_open,
  accordion_content: accordion_content,
}, with_context: false) }}
{% endstory %}

{% story IndependentItem with {
  name: 'One independent item',
  args: {
    id: 'independent-item-demo',
    always_open: false,
  },
} %}
{% set accordion_content %}
    {% set accordion_content %}
        <p class="mb-0">This item is grouped normally — opening it closes its siblings.</p>
      {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-block', {
      title: 'Grouped item',
      heading_level: 3,
      open_by_default: true,
      parent_id: id,
      accordion_content: accordion_content,
    }, with_context: false) }}

    {% set accordion_content %}
        <p class="mb-0">This item uses <code>always_open: true</code> directly, so it stays open regardless of what happens to its siblings.</p>
      {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-block', {
      title: 'Independent item',
      heading_level: 3,
      open_by_default: true,
      always_open: true,
      parent_id: id,
      accordion_content: accordion_content,
    }, with_context: false) }}
  {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-container', {
  id: id,
  always_open: always_open,
  accordion_content: accordion_content,
}, with_context: false) }}
{% endstory %}

{% story FAQExample with {
  name: 'FAQ example',
  args: {
    id: 'faq-accordion',
    always_open: false,
  },
} %}
{% set accordion_content %}
    {% set accordion_content %}
        <p class="mb-0">Go to the login page and click <strong>Forgot password</strong>. Enter your email address and we will send you a reset link within a few minutes.</p>
      {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-block', {
      title: 'How do I reset my password?',
      heading_level: 3,
      open_by_default: true,
      item_id: 'faq-password',
      parent_id: id,
      accordion_content: accordion_content,
    }, with_context: false) }}

    {% set accordion_content %}
        <p class="mb-0">Yes. Navigate to <strong>Account settings &rarr; Profile</strong> and update your email. A confirmation link will be sent to both your old and new address.</p>
      {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-block', {
      title: 'Can I change my email address?',
      heading_level: 3,
      open_by_default: false,
      item_id: 'faq-email',
      parent_id: id,
      accordion_content: accordion_content,
    }, with_context: false) }}

    {% set accordion_content %}
        <p class="mb-0">Open <strong>Account settings &rarr; Billing</strong> and click <strong>Cancel plan</strong>. Your access continues until the end of the current billing period.</p>
      {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-block', {
      title: 'How do I cancel my subscription?',
      heading_level: 3,
      open_by_default: false,
      item_id: 'faq-cancel',
      parent_id: id,
      accordion_content: accordion_content,
    }, with_context: false) }}

    {% set accordion_content %}
        <p class="mb-0">Your data is retained for 30 days after cancellation. You can export it at any time from the account dashboard before it is permanently removed.</p>
      {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-block', {
      title: 'Is my data deleted after cancellation?',
      heading_level: 3,
      open_by_default: false,
      item_id: 'faq-data',
      parent_id: id,
      accordion_content: accordion_content,
    }, with_context: false) }}
  {% endset %}
{{ include('vartheme_bs5_horizonaid:accordion-container', {
  id: id,
  always_open: always_open,
  accordion_content: accordion_content,
}, with_context: false) }}
{% endstory %}

{% endstories %}
