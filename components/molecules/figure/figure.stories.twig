{% stories Figure with {
  title: 'Molecules/Figure',
  parameters: {
    componentSubtitle: 'Stat figure card',
    docs: {
      description: {
        component: 'Stat figure card with a large number and a description label. Background and font sizes/colors are all configurable via Bootstrap utilities — no custom CSS.',
      },
      story: {inline: true},
    },
  },
  argTypes: {
    number: {
      name: 'Number',
      description: 'The main statistic number displayed prominently.',
      defaultValue: '0000',
      control: 'text',
    },
    description: {
      name: 'Description',
      description: 'Short descriptive label displayed below the number.',
      defaultValue: 'Number description',
      control: 'text',
    },
    background_color: {
      name: 'Background color',
      description: 'Brand background color applied to the card.',
      defaultValue: 'bg-accent-subtle',
      control: 'select',
      options: {
        'None': 'none',
        "'Body tertiary'": 'bg-body-tertiary',
        'Tertiary': 'bg-tertiary',
        'Accent': 'bg-accent',
        "'Accent subtle'": 'bg-accent-subtle',
        'Primary': 'bg-primary',
        "'Primary subtle'": 'bg-primary-subtle',
        'Secondary': 'bg-secondary',
        "'Secondary subtle'": 'bg-secondary-subtle',
        'Dark': 'bg-dark',
      },
    },
    align: {
      name: 'Alignment',
      description: 'Bootstrap text-* utility for the horizontal alignment of both the number and the description.',
      defaultValue: 'text-start',
      control: 'select',
      options: {
        'Left': 'text-start',
        'Center': 'text-center',
        'Right': 'text-end',
      },
    },
    number_size: {
      name: 'Number size',
      description: 'Bootstrap display-* utility for the number font size.',
      defaultValue: 'display-1',
      control: 'select',
      options: {
        "'Display 1 (largest)'": 'display-1',
        "'Display 2'": 'display-2',
        "'Display 3'": 'display-3',
        "'Display 4'": 'display-4',
        "'Display 5'": 'display-5',
        "'Display 6 (smallest)'": 'display-6',
      },
    },
    number_color: {
      name: 'Number color',
      description: 'Bootstrap text color utility for the number.',
      defaultValue: 'text-black',
      control: 'select',
      options: {
        'Body': 'text-body',
        'Primary': 'text-primary',
        'Secondary': 'text-secondary',
        'Muted': 'text-muted',
        'White': 'text-white',
        "'White 50%'": 'text-white-50',
        'Dark': 'text-dark',
        'Black': 'text-black',
        "'Black 50%'": 'text-black-50',
      },
    },
    description_size: {
      name: 'Description size',
      description: 'Bootstrap fs-* utility for the description font size.',
      defaultValue: 'fs-6',
      control: 'select',
      options: {
        "'FS 1 (largest)'": 'fs-1',
        "'FS 2'": 'fs-2',
        "'FS 3'": 'fs-3',
        "'FS 4'": 'fs-4',
        "'FS 5'": 'fs-5',
        "'FS 6 (smallest)'": 'fs-6',
      },
    },
    description_color: {
      name: 'Description color',
      description: 'Bootstrap text color utility for the description label.',
      defaultValue: 'text-black',
      control: 'select',
      options: {
        'Body': 'text-body',
        'Primary': 'text-primary',
        'Secondary': 'text-secondary',
        'Muted': 'text-muted',
        'White': 'text-white',
        "'White 50%'": 'text-white-50',
        'Dark': 'text-dark',
        'Black': 'text-black',
        "'Black 50%'": 'text-black-50',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default (Accent subtle)',
  args: {
    number: '0000',
