---
{% stories Taxonomy with {
  title: 'Base/Taxonomy',
  parameters: {
    componentSubtitle: 'Taxonomy badge',
    docs: {
      description: {
        component: 'Taxonomy component that can render as plain text or a link. Styled entirely with Bootstrap utilities — bg/text color pairing, size and radius. No custom CSS.',
      },
      story: {inline: true},
    },
  },
  argTypes: {
    label: {
      name: 'Label',
      description: 'Text shown inside the taxonomy badge.',
      defaultValue: 'Taxonomy',
      control: 'text',
    },
    url: {
      name: 'Link (optional)',
      description: 'If provided, taxonomy will render as a link.',
      defaultValue: '',
      control: 'text',
    },
    target: {
      name: 'Link target',
      description: 'Where to open the link (only used when Link is provided).',
      defaultValue: '_self',
      control: 'select',
      options: {
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
    size: {
      name: 'Size',
      description: 'Typography size (taxonomy modifier class).',
      defaultValue: 'taxonomy-lg',
      control: 'select',
      options: {
        Large: 'taxonomy-lg',
        Small: 'taxonomy-sm',
      },
    },
    color: {
      name: 'Color',
      description: 'Background/text color pairing (taxonomy modifier class).',
      defaultValue: 'taxonomy-primary',
      control: 'select',
      options: {
        Primary: 'taxonomy-primary',
        Secondary: 'taxonomy-secondary',
        Tertiary: 'taxonomy-tertiary',
      },
    },

  },
} %}

{% story Default with {
  name: 'Default (Large)',
  args: {
    label: 'Taxonomy',
    url: '',
    target: '_self',
    size: 'taxonomy-lg',
    color: 'taxonomy-primary',
  },
} %}
{{ include('vartheme_bs5_horizonaid:taxonomy') }}
{% endstory %}

{% story Small with {
  name: 'Small',
  args: {
    label: 'Small taxonomy',
    size: 'taxonomy-sm',
  },
} %}
{{ include('vartheme_bs5_horizonaid:taxonomy') }}
{% endstory %}

{% story WithLink with {
  name: 'With link',
  args: {
    label: 'Linked taxonomy',
    url: 'https://example.com',
    target: '_blank',
    size: 'taxonomy-lg',
  },
} %}
{{ include('vartheme_bs5_horizonaid:taxonomy') }}
{% endstory %}

{% story ColorPrimary with {
  name: 'Color: Primary',
  args: {
    label: 'Primary',
    color: 'taxonomy-primary',
  },
} %}
{{ include('vartheme_bs5_horizonaid:taxonomy') }}
{% endstory %}

{% story ColorSecondary with {
  name: 'Color: Secondary',
  args: {
    label: 'Secondary',
    color: 'taxonomy-secondary',
  },
} %}
{{ include('vartheme_bs5_horizonaid:taxonomy') }}
{% endstory %}

{% story ColorTertiary with {
  name: 'Color: Tertiary',
  args: {
    label: 'Tertiary',
    color: 'taxonomy-tertiary',
  },
} %}
{{ include('vartheme_bs5_horizonaid:taxonomy') }}
{% endstory %}

{% endstories %}
