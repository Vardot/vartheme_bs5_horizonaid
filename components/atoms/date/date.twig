{#
/**
 * @file
 * Vartheme BS5 Horizonaid Starter Kit implementation for the Date component.
 *
 * Uses the <time> element to embed a machine-readable ISO 8601 date.
 * The date value is rendered as visible text content server-side.
 *
 * Available properties:
 * - date: ISO 8601 date string for the datetime attribute (e.g. 2025-01-31). Defaults to today's date.
 * - size: Font size class. (fs-1|fs-2|fs-3|fs-4|fs-5|fs-6) Defaults to none (inherits from context).
 * - text_color: Bootstrap text color utility class.
 *              (text-primary|text-secondary|text-success|text-danger|text-warning|
 *               text-info|text-muted|text-white|text-dark|text-body) Defaults to text-body.
 *
 * Available attributes:
 * - attributes: HTML attributes for the time element.
 *
 * Available slots:
 * - N/A
 *
 * - MDN <time>: https://developer.mozilla.org/en-US/docs/Web/HTML/Element/time
 * - JSON Schema "date" format: https://json-schema.org/understanding-json-schema/reference/string.html#dates-and-times
 * - RFC 3339: https://www.rfc-editor.org/rfc/rfc3339
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set date = date|default('now'|date('Y-m-d')) %}
{% set text_color = text_color|default('text-body') %}
{% set format = format|default('M j, Y') %}
{% set icon = icon|default('none') %}

{# Logic: a Smart Date field item gives a UNIX timestamp and wins over an ISO
 # 8601 date string. format_date renders both in the site's timezone. #}
{% set timestamp = timestamp|default(null) %}
{% set stamp = timestamp ?: date|date('U') %}

{# Logic: optional utility classes, only when set. #}
{% set size_classes = size is defined and size is not empty ? [size] : [] %}
{% set weight_classes = weight is defined and weight is not empty ? [weight] : [] %}
{% set text_color_classes = text_color is not empty ? [text_color] : [] %}

{# Logic: merge all classes as arrays. #}
{# Logic: `d-inline-flex` keeps the date inline with its siblings, which puts it
 # on the same line as an adjacent inline element such as a button; `d-flex`
 # gives it its own line. #}
{% set display_class = display|default('inline') == 'block' ? 'd-flex' : 'd-inline-flex' %}

{% set classes = [
  'vb-date',
  display_class,
  'align-items-center',
  'gap-2',
]|merge(size_classes)|merge(weight_classes)|merge(text_color_classes) %}

{% set attributes = attributes.addClass(classes) %}
{% set attributes = attributes.setAttribute('datetime', stamp|format_date('custom', 'Y-m-d')) %}

{# Print the HTML. #}
<time{{ attributes }}>
  {% if icon != 'none' %}
    <i class="bi bi-{{ icon }} d-inline-block lh-1" aria-hidden="true"></i>
  {% endif %}
  <span>{{ stamp|format_date('custom', format) }}</span>
</time>
