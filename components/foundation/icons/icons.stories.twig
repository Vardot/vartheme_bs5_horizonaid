          <span class="small text-muted text-center" style="font-size: 11px; word-break: break-all;">{{ icon }}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  {# Care & Health icons #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Care &amp; Health</h2>
    <div class="d-flex flex-wrap gap-4">
      {% set care_icons = ['heart', 'heart-fill', 'heart-pulse', 'hospital', 'bandaid', 'bandaid-fill', 'capsule', 'prescription2', 'clipboard2-pulse', 'clipboard2-pulse-fill', 'clipboard2-heart', 'clipboard2-heart-fill', 'shield-check', 'shield-plus', 'droplet', 'droplet-fill', 'droplet-half', 'water', 'life-preserver'] %}
      {% for icon in care_icons %}
        <div class="d-flex flex-column align-items-center gap-2" style="width: 80px;">
          {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: icon, icon_size: 'fs-3' }) }}
          <span class="small text-muted text-center" style="font-size: 11px; word-break: break-all;">{{ icon }}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  {# People & Community icons #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">People &amp; Community</h2>
    <div class="d-flex flex-wrap gap-4">
      {% set people_icons = ['people', 'people-fill', 'person', 'person-fill', 'person-heart', 'person-hearts', 'person-check', 'person-check-fill', 'person-plus', 'person-plus-fill', 'person-badge', 'person-badge-fill', 'hand-thumbs-up', 'hand-thumbs-up-fill', 'hand-index-thumb'] %}
      {% for icon in people_icons %}
        <div class="d-flex flex-column align-items-center gap-2" style="width: 80px;">
          {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: icon, icon_size: 'fs-3' }) }}
          <span class="small text-muted text-center" style="font-size: 11px; word-break: break-all;">{{ icon }}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  {# Education icons #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Education</h2>
    <div class="d-flex flex-wrap gap-4">
      {% set education_icons = ['mortarboard', 'mortarboard-fill', 'book', 'book-fill', 'book-half', 'backpack', 'backpack-fill', 'backpack2', 'backpack2-fill', 'pencil', 'pencil-fill', 'journal-medical'] %}
      {% for icon in education_icons %}
        <div class="d-flex flex-column align-items-center gap-2" style="width: 80px;">
          {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: icon, icon_size: 'fs-3' }) }}
          <span class="small text-muted text-center" style="font-size: 11px; word-break: break-all;">{{ icon }}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  {# Shelter & Basic Needs icons #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Shelter &amp; Basic Needs</h2>
    <div class="d-flex flex-wrap gap-4">
      {% set shelter_icons = ['house', 'house-fill', 'house-heart', 'house-heart-fill', 'basket', 'basket-fill', 'basket3', 'basket3-fill', 'cup-hot', 'cup-hot-fill', 'umbrella', 'gift', 'gift-fill', 'sun', 'sun-fill', 'cloud-rain', 'cloud-rain-fill', 'tree-fill', 'leaf', 'recycle'] %}
      {% for icon in shelter_icons %}
        <div class="d-flex flex-column align-items-center gap-2" style="width: 80px;">
          {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: icon, icon_size: 'fs-3' }) }}
          <span class="small text-muted text-center" style="font-size: 11px; word-break: break-all;">{{ icon }}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  {# Donations & Funding icons #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Donations &amp; Funding</h2>
    <div class="d-flex flex-wrap gap-4">
      {% set donation_icons = ['cash', 'cash-coin', 'currency-dollar', 'currency-exchange', 'wallet2', 'piggy-bank', 'piggy-bank-fill', 'credit-card', 'credit-card-fill', 'envelope-heart', 'envelope-heart-fill'] %}
      {% for icon in donation_icons %}
        <div class="d-flex flex-column align-items-center gap-2" style="width: 80px;">
          {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: icon, icon_size: 'fs-3' }) }}
          <span class="small text-muted text-center" style="font-size: 11px; word-break: break-all;">{{ icon }}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  {# Global Reach icons #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Global Reach</h2>
    <div class="d-flex flex-wrap gap-4">
      {% set global_icons = ['globe', 'globe2', 'globe-americas', 'geo-alt', 'geo-alt-fill', 'geo-fill', 'pin-map', 'pin-map-fill', 'compass', 'compass-fill', 'signpost', 'signpost-fill', 'truck', 'airplane', 'airplane-fill', 'suitcase', 'suitcase-fill'] %}
      {% for icon in global_icons %}
        <div class="d-flex flex-column align-items-center gap-2" style="width: 80px;">
          {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: icon, icon_size: 'fs-3' }) }}
          <span class="small text-muted text-center" style="font-size: 11px; word-break: break-all;">{{ icon }}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  {# Advocacy & Impact icons #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Advocacy &amp; Impact</h2>
    <div class="d-flex flex-wrap gap-4">
      {% set advocacy_icons = ['megaphone', 'megaphone-fill', 'flag', 'flag-fill', 'chat-heart', 'chat-heart-fill', 'award', 'award-fill', 'trophy', 'trophy-fill', 'lightbulb', 'lightbulb-fill', 'emoji-smile'] %}
      {% for icon in advocacy_icons %}
        <div class="d-flex flex-column align-items-center gap-2" style="width: 80px;">
          {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: icon, icon_size: 'fs-3' }) }}
          <span class="small text-muted text-center" style="font-size: 11px; word-break: break-all;">{{ icon }}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  {# Social Media icons #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Social Media</h2>
    <div class="d-flex flex-wrap gap-4">
      {% set social_icons = ['instagram', 'facebook', 'linkedin', 'twitter', 'twitter-x', 'youtube', 'github', 'whatsapp', 'telegram', 'discord', 'twitch', 'pinterest', 'reddit', 'snapchat', 'spotify', 'tiktok', 'vimeo', 'slack', 'skype', 'apple', 'google', 'google-play', 'windows', 'microsoft', 'dropbox', 'paypal', 'behance', 'dribbble', 'medium', 'wordpress'] %}
      {% for icon in social_icons %}
        <div class="d-flex flex-column align-items-center gap-2" style="width: 80px;">
          {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: icon, icon_size: 'fs-3' }) }}
          <span class="small text-muted text-center" style="font-size: 11px; word-break: break-all;">{{ icon }}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  {# Icon sizes #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Icon Sizes</h2>
    <p class="mb-4">Use Bootstrap font-size utilities or custom rem values.</p>
    <div class="d-flex align-items-end gap-5">
      <div class="d-flex flex-column align-items-center gap-2">
        {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: 'star-fill', icon_size: 'fs-1', color: 'text-primary' }) }}
        <span class="small text-muted"><code>fs-1</code></span>
      </div>
      <div class="d-flex flex-column align-items-center gap-2">
        {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: 'star-fill', icon_size: 'fs-2', color: 'text-primary' }) }}
        <span class="small text-muted"><code>fs-2</code></span>
      </div>
      <div class="d-flex flex-column align-items-center gap-2">
        {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: 'star-fill', icon_size: 'fs-3', color: 'text-primary' }) }}
        <span class="small text-muted"><code>fs-3</code></span>
      </div>
      <div class="d-flex flex-column align-items-center gap-2">
        {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: 'star-fill', icon_size: 'fs-4', color: 'text-primary' }) }}
        <span class="small text-muted"><code>fs-4</code></span>
      </div>
      <div class="d-flex flex-column align-items-center gap-2">
        {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: 'star-fill', icon_size: 'fs-5', color: 'text-primary' }) }}
        <span class="small text-muted"><code>fs-5</code></span>
      </div>
      <div class="d-flex flex-column align-items-center gap-2">
        {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: 'star-fill', icon_size: 'fs-6', color: 'text-primary' }) }}
        <span class="small text-muted"><code>fs-6</code></span>
      </div>
    </div>
  </div>

  {# Icon colors #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Icon Colors</h2>
    <div class="d-flex flex-wrap gap-4">
      {% set colors = ['text-primary', 'text-secondary', 'text-success', 'text-danger', 'text-warning', 'text-info', 'text-dark', 'text-muted'] %}
      {% for color in colors %}
        <div class="d-flex flex-column align-items-center gap-2">
          {{ include('vartheme_bs5_horizonaid:bootstrap-icon', { icon: 'circle-fill', icon_size: 'fs-3', color: color }) }}
          <span class="small text-muted"><code>{{ color }}</code></span>
        </div>
      {% endfor %}
    </div>
  </div>

  {# Backend icons #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Backend Icons</h2>
    <div class="d-flex flex-wrap gap-4">
      <div class="d-flex flex-column align-items-center gap-2" style="width: 80px;">
        <img src="/components/foundation/images/assets/figma-logo.svg" width="32" alt="Figma icon" />
        <span class="small text-muted text-center" style="font-size: 11px;">figma</span>
      </div>
      <div class="d-flex flex-column align-items-center gap-2" style="width: 80px;">
        <img src="/components/foundation/images/assets/lightbulb.svg" width="32" alt="Lightbulb icon" />
        <span class="small text-muted text-center" style="font-size: 11px;">lightbulb</span>
      </div>
    </div>
  </div>

</div>

{% endstory %}

{% endstories %}
