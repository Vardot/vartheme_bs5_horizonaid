{% story Logos with {
  name: 'Logos',
} %}

<div class="px-5 py-5">
  <h1 class="fw-bold display-5 mb-5">Logo &amp; Share Image</h1>

  {# Logo section #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Logo</h2>
    <div class="d-inline-flex align-items-center gap-4 rounded-3 px-4 py-3"
         style="background-color: #FFF8E7;">
      <img style="height: 24px;"
           src="/components/foundation/images/assets/full-logo-light.svg"
           alt="Horizon Aid logo (light mode)"
           title="Horizon Aid logo (light mode)" />
      <img style="height: 24px; background-color: #0D2C54; padding: 4px; border-radius: 4px;"
           src="/components/foundation/images/assets/full-logo-dark.svg"
           alt="Horizon Aid logo (dark mode)"
           title="Horizon Aid logo (dark mode)" />
    </div>
  </div>

  {# Favicon section #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Favicon</h2>
    <div class="d-inline-flex align-items-center gap-5 rounded-3 px-5 py-4"
         style="border: 1px dashed #FFE69C;">
      <img src="/components/foundation/images/assets/favicon.svg"
           alt="Horizon Aid favicon 152x152" title="152 × 152" style="width: 80px;" />
      <img src="/components/foundation/images/assets/favicon.svg"
           alt="Horizon Aid favicon 120x120" title="120 × 120" style="width: 63px;" />
      <img src="/components/foundation/images/assets/favicon.svg"
           alt="Horizon Aid favicon 76x76" title="76 × 76" style="width: 39px;" />
      <img src="/components/foundation/images/assets/favicon.svg"
           alt="Horizon Aid favicon 60x60" title="60 × 60" style="width: 32px;" />
      <img src="/components/foundation/images/assets/favicon.svg"
           alt="Horizon Aid favicon 16x16" title="16 × 16" style="width: 16px;" />
    </div>
  </div>

  {# Share Image section #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Share Image</h2>
    <img src="/components/foundation/images/assets/share-image.png"
         class="img-fluid rounded-3"
         alt="Horizon Aid social share image"
         title="Horizon Aid social share image" />
  </div>
</div>

{% endstory %}

{% endstories %}
